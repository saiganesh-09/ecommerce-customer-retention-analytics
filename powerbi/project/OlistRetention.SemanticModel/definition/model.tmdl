annotation PBI_ProTooling = ["DevMode"]

ref table fact_orders
ref table dim_customers
ref table dim_date
ref table cohort_retention
ref table cohort_sizes
ref table cohort_summary
ref table rfm_segments
ref table segment_opportunity
ref table review_by_delivery
ref table review_distribution_by_delivery
ref table repeat_by_first_delivery
