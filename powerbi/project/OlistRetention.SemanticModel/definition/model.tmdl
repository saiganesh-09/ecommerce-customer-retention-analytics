model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fact_orders
ref table dim_customers
ref table dim_date
ref table cohort_retention
ref table cohort_sizes
ref table cohort_summary
ref table rfm_segments
ref table segment_opportunity
ref table review_by_delivery
ref table review_distribution_by_delivery
ref table repeat_by_first_delivery
ref table late_by_state
ref table late_by_category
ref table monthly_orders
ref table revenue_by_category
ref table customer_purchase_frequency

ref cultureInfo en-US
