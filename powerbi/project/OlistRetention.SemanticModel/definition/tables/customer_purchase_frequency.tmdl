	partition customer_purchase_frequency = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/customer_purchase_frequency.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"order_count", Int64.Type},{"customers", Int64.Type},{"pct_of_customers", type number},{"revenue_brl", type number},{"pct_of_revenue", type number}})
				in
				    ChangedType

	annotation PBI_ResultType = Table

