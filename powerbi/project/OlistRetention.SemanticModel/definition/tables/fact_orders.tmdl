	measure 'Total Orders' = ```
			COUNTROWS(fact_orders)
			```
		lineageTag: 1f64ac2c-c498-4650-a529-13f8e85956ad
		formatString: 0

	measure 'Qualifying Orders' = ```
			CALCULATE([Total Orders],fact_orders[is_qualifying_order]=TRUE())
			```
		lineageTag: 105ca8cf-928f-4344-b5e3-cd00ddd073cf
		formatString: 0

	measure 'Unique Customers' = ```
			CALCULATE(DISTINCTCOUNT(fact_orders[customer_unique_id]),fact_orders[is_qualifying_order]=TRUE())
			```
		lineageTag: d269d970-5a47-4f8c-aa09-46a93116d595
		formatString: 0

	measure 'Total Revenue (BRL)' = ```
			CALCULATE(SUM(fact_orders[order_total_value]),fact_orders[is_qualifying_order]=TRUE())
			```
		lineageTag: 31de870d-6de3-4fc0-840c-afc3ddbbc9fb
		formatString: #,##0.00

	measure 'Avg Order Value (BRL)' = ```
			DIVIDE([Total Revenue (BRL)],[Qualifying Orders])
			```
		lineageTag: aad0f961-e462-407d-a464-9217e40b8c9d
		formatString: #,##0.00

	measure 'Delivered With Timestamps' = ```
			CALCULATE([Total Orders],fact_orders[order_status]="delivered",NOT ISBLANK(fact_orders[delivered_date]),NOT ISBLANK(fact_orders[estimated_delivery_date]))
			```
		lineageTag: 102ae1a1-4196-48ab-9dce-70a4a44e5be1
		formatString: 0

	measure 'Late Orders' = ```
			CALCULATE([Total Orders],fact_orders[is_late_delivery]=TRUE())
			```
		lineageTag: bb0986ec-5d3c-4e1b-b757-d00a232d45df
		formatString: 0

	measure 'Late Delivery %' = ```
			DIVIDE([Late Orders],[Delivered With Timestamps])*100
			```
		lineageTag: 443011f6-35d2-4a86-9ebe-adeb20024b87
		formatString: 0.00

	measure 'Avg Delivery Days' = ```
			CALCULATE(AVERAGE(fact_orders[delivery_days]),fact_orders[order_status]="delivered",NOT ISBLANK(fact_orders[delivery_days]))
			```
		lineageTag: c4b9799a-9644-408d-b4dc-63825a448e0b
		formatString: 0.0

	measure 'Avg Review Score' = ```
			CALCULATE(AVERAGE(fact_orders[review_score]),fact_orders[order_status]="delivered")
			```
		lineageTag: af59df0c-1342-48ca-8867-4b77a352fb9c
		formatString: 0.00

	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/fact_orders.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"order_id", type text},{"customer_unique_id", type text},{"purchase_date", type date},{"purchase_month", type date},{"order_status", type text},{"is_qualifying_order", type logical},{"item_count", Int64.Type},{"items_value", type number},{"freight_value", type number},{"order_total_value", type number},{"payment_total", type number},{"payment_types", type text},{"max_installments", Int64.Type},{"delivered_date", type date},{"estimated_delivery_date", type date},{"delivery_days", Int64.Type},{"delivery_delay_days", Int64.Type},{"is_late_delivery", type logical},{"review_score", Int64.Type},{"primary_category", type text},{"customer_state", type text},{"customer_city", type text}})
				in
				    ChangedType

	annotation PBI_ResultType = Table
