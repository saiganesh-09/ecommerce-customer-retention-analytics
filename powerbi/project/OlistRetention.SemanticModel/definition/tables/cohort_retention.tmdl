table cohort_retention
	lineageTag: ebea6700-afc7-441d-b0d0-e76d5431d805

	column cohort_month
		dataType: dateTime
		sourceColumn: cohort_month
		lineageTag: 24c5da5c-eb95-43fe-a375-e719313bf8b7
		summarizeBy: none

	column cohort_size
		dataType: int64
		sourceColumn: cohort_size
		lineageTag: ff8177dd-c6ec-4089-95d1-96e02991e965
		summarizeBy: none

	column months_since_first
		dataType: int64
		sourceColumn: months_since_first
		lineageTag: cee5e981-37cb-48d7-87e8-c2176ecb98a9
		summarizeBy: none

	column activity_month
		dataType: dateTime
		sourceColumn: activity_month
		lineageTag: 101e3348-e58d-4a9b-ab10-6f251bd24ec0
		summarizeBy: none

	column active_customers
		dataType: int64
		sourceColumn: active_customers
		lineageTag: 3ca3ba51-eee3-492b-a05a-174b9070c299
		summarizeBy: none

	column retention_pct
		dataType: double
		sourceColumn: retention_pct
		lineageTag: 2eb04607-c6be-4894-8cda-01948548dbb6
		summarizeBy: none

	column is_observed
		dataType: boolean
		sourceColumn: is_observed
		lineageTag: 951d9f32-ef73-4696-9b3d-648ecefb57d3
		summarizeBy: none

	measure 'Retention %' = ```
			AVERAGE(cohort_retention[retention_pct])
			```
		lineageTag: a8ced91e-13f4-4c00-82ef-b526dd96157f
		formatString: 0.00

	partition cohort_retention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/cohort_retention.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"cohort_month", type date},{"cohort_size", Int64.Type},{"months_since_first", Int64.Type},{"activity_month", type date},{"active_customers", Int64.Type},{"retention_pct", type number},{"is_observed", type logical}})
				in
				    ChangedType

	annotation PBI_ResultType = Table
