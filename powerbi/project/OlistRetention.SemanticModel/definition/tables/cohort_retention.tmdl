table cohort_retention
	lineageTag: ee9a4c4a-7775-4c0c-9c75-8a4482fb67b4

	column cohort_month
		dataType: dateTime
		sourceColumn: cohort_month
		lineageTag: 92ca2257-92a6-4883-bc54-c0c160f9e5a9
		summarizeBy: none

	column cohort_size
		dataType: int64
		sourceColumn: cohort_size
		lineageTag: 83ce8536-82d8-4f6d-bbb9-540265cacd06
		summarizeBy: none

	column months_since_first
		dataType: int64
		sourceColumn: months_since_first
		lineageTag: 5a244d0b-6585-4e5a-88a0-7d790fa75eae
		summarizeBy: none

	column activity_month
		dataType: dateTime
		sourceColumn: activity_month
		lineageTag: 39b4117a-5d90-4df8-90b4-02c2955889ea
		summarizeBy: none

	column active_customers
		dataType: int64
		sourceColumn: active_customers
		lineageTag: 8328e094-4efe-4605-a258-e926a3c732a5
		summarizeBy: none

	column retention_pct
		dataType: double
		sourceColumn: retention_pct
		lineageTag: 79c545c6-4b24-4c79-8bb1-165cbcfdcd0d
		summarizeBy: none

	column is_observed
		dataType: boolean
		sourceColumn: is_observed
		lineageTag: ea27876b-349d-4549-80a5-170f930553f8
		summarizeBy: none

	measure 'Retention %' = ```
			AVERAGE(cohort_retention[retention_pct])
			```
		lineageTag: de863942-0efd-4d90-bc61-4050dcd61a9f
		formatString: 0.00

	partition cohort_retention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/cohort_retention.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"cohort_month", type date},{"cohort_size", Int64.Type},{"months_since_first", Int64.Type},{"activity_month", type date},{"active_customers", Int64.Type},{"retention_pct", type number},{"is_observed", type logical}})
				in
				    ChangedType

	annotation PBI_ResultType = Table
