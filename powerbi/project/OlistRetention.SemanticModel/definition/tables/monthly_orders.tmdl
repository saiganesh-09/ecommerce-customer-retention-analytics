table monthly_orders
	lineageTag: 49d90795-09af-437a-b30d-2c787a771f20

	column purchase_month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 670c573c-e61c-4352-9237-a22e09138f41
		summarizeBy: none
		sourceColumn: purchase_month

		annotation UnderlyingDateTimeDataType = Date

	column orders
		dataType: int64
		lineageTag: c279724b-cc2a-474f-88cd-ed85447701ad
		summarizeBy: none
		sourceColumn: orders

	column active_customers
		dataType: int64
		lineageTag: 3bceef17-9557-48c7-9867-a36552011bde
		summarizeBy: none
		sourceColumn: active_customers

	column revenue_brl
		dataType: double
		lineageTag: 0e303523-2b62-4eed-b1f0-413e20a2f4aa
		summarizeBy: none
		sourceColumn: revenue_brl

	column avg_order_value_brl
		dataType: double
		lineageTag: 13a0c347-0a43-41f2-afb4-4fb886c1d2d7
		summarizeBy: none
		sourceColumn: avg_order_value_brl

	column avg_delivery_days
		dataType: double
		lineageTag: 008bf768-f391-47e8-b066-9d483625bfea
		summarizeBy: none
		sourceColumn: avg_delivery_days

	partition monthly_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/monthly_orders.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"purchase_month", type date},{"orders", Int64.Type},{"active_customers", Int64.Type},{"revenue_brl", type number},{"avg_order_value_brl", type number},{"avg_delivery_days", type number}})
				in
				    ChangedType

	annotation PBI_ResultType = Table

