	measure 'Customers' = ```
			COUNTROWS(dim_customers)
			```
		lineageTag: 0f68af62-c2c5-4195-b031-593a23843d6b
		formatString: 0

	measure 'Repeat Customers' = ```
			CALCULATE([Customers],dim_customers[is_repeat_customer]=TRUE())
			```
		lineageTag: 1bfe8e78-473f-4186-9b18-8a51fbc7963e
		formatString: 0

	measure 'Repeat Purchase Rate %' = ```
			DIVIDE([Repeat Customers],[Customers])*100
			```
		lineageTag: 01fa6ea0-654a-4687-ad18-a70ccaf53770
		formatString: 0.00

	measure 'Avg Customer Spend (BRL)' = ```
			AVERAGE(dim_customers[monetary_brl])
			```
		lineageTag: e9bd7194-ecf0-46b2-b279-4538cba1baed
		formatString: #,##0.00

