	measure 'Customers' = ```
			COUNTROWS(dim_customers)
			```
		lineageTag: a0efb6ce-b41a-45a8-b88e-d50dd91393f7
		formatString: 0

	measure 'Repeat Customers' = ```
			CALCULATE([Customers],dim_customers[is_repeat_customer]=TRUE())
			```
		lineageTag: ec4392f0-fae3-4f69-8d20-9bea0001550b
		formatString: 0

	measure 'Repeat Purchase Rate %' = ```
			DIVIDE([Repeat Customers],[Customers])*100
			```
		lineageTag: abf463d9-5dac-472c-8046-bb612062ec95
		formatString: 0.00

	measure 'Avg Customer Spend (BRL)' = ```
			AVERAGE(dim_customers[monetary_brl])
			```
		lineageTag: d9edebb0-0733-425e-bbe7-35abb2b2ef0d
		formatString: #,##0.00

