table cohort_sizes
	lineageTag: 8658027d-d600-4115-a286-e8bd098aa9e8

	column cohort_month
		dataType: dateTime
		formatString: Long Date
		lineageTag: f3d77c9e-1134-4824-98eb-beb1b8a99587
		summarizeBy: none
		sourceColumn: cohort_month

		annotation UnderlyingDateTimeDataType = Date

	column cohort_size
		dataType: int64
		lineageTag: 5abbbf1d-61f6-4fa0-9783-02fcd3985637
		summarizeBy: none
		sourceColumn: cohort_size

	column cumulative_customers
		dataType: double
		lineageTag: c88c9445-8420-4c66-9b1f-4ee36b9cb1e8
		summarizeBy: none
		sourceColumn: cumulative_customers

	partition cohort_sizes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/cohort_sizes.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"cohort_month", type date},{"cohort_size", Int64.Type},{"cumulative_customers", type number}})
				in
				    ChangedType

	annotation PBI_ResultType = Table

